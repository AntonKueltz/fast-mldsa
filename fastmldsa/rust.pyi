from enum import Enum

class ParameterSet(Enum):
    ML_DSA_44 = 44
    ML_DSA_65 = 65
    ML_DSA_87 = 87

class VerificationKey:
    def __bytes__(self) -> bytes: ...
    def to_bytes(self) -> bytes: ...
    @staticmethod
    def from_bytes(data: bytes) -> VerificationKey: ...

class SigningKey:
    def __bytes__(self) -> bytes: ...
    def to_bytes(self) -> bytes: ...
    @staticmethod
    def from_bytes(data: bytes) -> SigningKey: ...

class ML_DSA:
    def __init__(self, parameter_set: ParameterSet): ...
    def key_gen(self) -> tuple[VerificationKey, SigningKey]: ...
    def sign(self, sk: SigningKey, msg: bytes, ctx: bytes) -> bytes: ...
    def verify(
        self, vk: VerificationKey, msg: bytes, ctx: bytes, sig: bytes
    ) -> bool: ...
